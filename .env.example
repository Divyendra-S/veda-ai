# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model. gemini-2.5-flash-lite is roughly six times cheaper and noticeably
# faster; gemini-2.5-flash reads handwriting more reliably.
# GEMINI_MODEL=gemini-2.5-flash
# Requests per minute to pace at. Unset means 10, which is the FREE tier's
# limit and the reason a run can take minutes. A billed key allows a thousand:
# set this and the pipeline stops waiting between calls.
# GEMINI_RPM=300

# Supabase — Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Replaces the legacy anon key. Safe in the
# client bundle: row-level security still gates every query.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Replaces service_role. Carries BYPASSRLS and skips
# every policy — server-side only, never commit, never expose to the browser.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Supabase MCP server (used by Claude Code, not by the app at runtime).
#
# These are read from your SHELL environment, not from .env.local, because
# .mcp.json is expanded by Claude Code before the app ever starts. Add to
# ~/.zshrc:
#
#   export SUPABASE_ACCESS_TOKEN=sbp_...
#   export SUPABASE_PROJECT_REF=sljoxjswtrwwsqomnopc
#
# Access token: https://supabase.com/dashboard/account/tokens
# ---------------------------------------------------------------------------
