# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role. Server-side only, never exposed to
# the browser: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Supabase MCP server (used by Claude Code, not by the app at runtime).
#
# These are read from your SHELL environment, not from .env.local, because
# .mcp.json is expanded by Claude Code before the app ever starts. Add them to
# ~/.zshrc:
#
#   export SUPABASE_ACCESS_TOKEN=sbp_...
#   export SUPABASE_PROJECT_REF=abcdefghijklmnop
#
# Access token: https://supabase.com/dashboard/account/tokens
# Project ref:  the subdomain of your project URL
#               https://<project-ref>.supabase.co
# ---------------------------------------------------------------------------
